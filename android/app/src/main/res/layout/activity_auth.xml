<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318"
    android:padding="16dp">

    <!-- Compact Centered MaterialCardView (Max Width ~340dp) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAuth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1C1F26"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="#FFC900"
        app:strokeWidth="1.5dp"
        app:layout_constraintWidth_max="340dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title & Subtitle -->
                <TextView
                    android:id="@+id/tvAuthTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Aramielle Account"
                    android:textColor="#FFEB87"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAuthSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:text="Sign in or create a new account"
                    android:textColor="#A0A5B5"
                    android:textSize="12sp" />

                <!-- Tab Toggle Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:background="#111318"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabSignin"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:backgroundTint="#FFC900"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Sign In"
                        android:textColor="#111318"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabRegister"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:backgroundTint="@android:color/transparent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Register"
                        android:textColor="#A0A5B5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- ================= SIGN IN FORM ================= -->
                <LinearLayout
                    android:id="@+id/layoutSigninForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <!-- Email/Mobile -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSigninAccount"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email or Mobile Number"
                        app:boxStrokeColor="#FFC900"
                        app:hintTextColor="#FFEB87">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSigninAccount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password with Password Toggle -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSigninPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Password"
                        app:boxStrokeColor="#FFC900"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#FFC900"
                        app:hintTextColor="#FFEB87">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSigninPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSigninSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#FFC900"
                        android:text="Sign In"
                        android:textColor="#111318"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- ================= REGISTER FORM WITH OTP ================= -->
                <LinearLayout
                    android:id="@+id/layoutRegisterForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Email/Mobile + Send OTP Button Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegisterAccount"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Email / Mobile"
                            app:boxStrokeColor="#FFC900"
                            app:hintTextColor="#FFEB87">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegisterAccount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendOtp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="8dp"
                            android:text="Send OTP"
                            android:textColor="#FFC900"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="#FFC900" />
                    </LinearLayout>

                    <!-- OTP Input + Countdown Timer -->
                    <LinearLayout
                        android:id="@+id/layoutOtpGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enter 6-Digit OTP"
                                android:textColor="#FFEB87"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvOtpTimer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Resend in 60s"
                                android:textColor="#FFC900"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegisterOtp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxStrokeColor="#FFC900">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegisterOtp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="6"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Password Field with Toggle -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegisterPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Password"
                        app:boxStrokeColor="#FFC900"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#FFC900"
                        app:hintTextColor="#FFEB87">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password Field with Toggle -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegisterConfirmPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Confirm Password"
                        app:boxStrokeColor="#FFC900"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#FFC900"
                        app:hintTextColor="#FFEB87">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegisterConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegisterSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#FFC900"
                        android:text="Register Account"
                        android:textColor="#111318"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- ================= DASHBOARD SESSION VIEW ================= -->
                <LinearLayout
                    android:id="@+id/layoutDashboardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome User"
                        android:textColor="#FFEB87"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="user@domain.com"
                        android:textColor="#A0A5B5"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogoutTrigger"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#E74C3C"
                        android:text="Log Out"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
